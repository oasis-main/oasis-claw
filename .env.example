# oasis-claw runtime environment
#
# Copy to .env and fill in the values you need.
# Only ONE LLM provider needs to be configured at a time.
# Switch active provider via OPENCLAW_DEFAULT_MODEL + `make recreate`.
#
# Secrets never go in docker-compose.runtime.yml — they live here and are
# loaded via `env_file: .env` in compose.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Telegram (inbound chat + outbound alerts).  Get from @BotFather.
OASIS_TELEGRAM_BOT_TOKEN=
OASIS_TELEGRAM_CHAT_ID=           # your numeric Telegram user ID

# ── LLM PROVIDERS (uncomment one set + set OPENCLAW_DEFAULT_MODEL) ──────────
#
# The model string format is:  <provider>/<model-id>
# Leave OPENCLAW_DEFAULT_MODEL unset to keep whatever openclaw already has.
#
# ---- Anthropic (default) ---------------------------------------------------
ANTHROPIC_API_KEY=
# OPENCLAW_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
# Other options: anthropic/claude-opus-4-5  anthropic/claude-haiku-4-5
#
# ---- Google Gemini ---------------------------------------------------------
# GEMINI_API_KEY=
# OPENCLAW_DEFAULT_MODEL=gemini/gemini-2.0-flash
# Other options: gemini/gemini-2.5-pro  gemini/gemini-2.5-flash
#
# ---- OpenAI ----------------------------------------------------------------
# OPENAI_API_KEY=
# OPENCLAW_DEFAULT_MODEL=openai/gpt-4o
# Other options: openai/gpt-4o-mini  openai/o3  openai/o4-mini
#
# ---- Amazon Bedrock --------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# OPENCLAW_DEFAULT_MODEL=bedrock/anthropic.claude-sonnet-4-5-v1:0
# Other options:
#   bedrock/amazon.nova-pro-v1:0
#   bedrock/meta.llama3-70b-instruct-v1:0
#   bedrock/anthropic.claude-haiku-4-5-v1:0
#
# ---- Ollama (local, host machine) ------------------------------------------
# Requires Ollama running on the Mac host. Model must be pulled first:
#   ollama pull llama3.3
# docker-compose.runtime.yml already adds extra_hosts host.docker.internal.
# OLLAMA_HOST=http://host.docker.internal:11434
# OPENCLAW_DEFAULT_MODEL=ollama/llama3.3
# Other options: ollama/qwen3  ollama/mistral  ollama/deepseek-r1
#
# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Set to 1 to print the full gateway token in container startup banner.
# OASIS_SHOW_TOKEN=0

# Pin openclaw version (default comes from Dockerfile ARG).
# OPENCLAW_VERSION=2026.4.26
