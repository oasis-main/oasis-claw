# oasis-claw runtime environment
#
# Copy to .env and fill in the values you need.
# Only ONE LLM provider needs to be configured at a time.
# Switch active provider via OPENCLAW_DEFAULT_MODEL + `make recreate`.
#
# Secrets never go in docker-compose.runtime.yml — they live here and are
# loaded via `env_file: .env` in compose.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Telegram (inbound chat + outbound alerts).  Get from @BotFather.
OASIS_TELEGRAM_BOT_TOKEN=
OASIS_TELEGRAM_CHAT_ID=           # your numeric Telegram user ID

# ── LLM PROVIDERS (uncomment one set + set OPENCLAW_DEFAULT_MODEL) ──────────
#
# The model string format is:  <provider>/<model-id>
# Leave OPENCLAW_DEFAULT_MODEL unset to keep an already-configured model, or to
# accept the built-in default of anthropic/claude-sonnet-4-6 (set ANTHROPIC_API_KEY).
#
# ---- Anthropic (default) ---------------------------------------------------
ANTHROPIC_API_KEY=
# OPENCLAW_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
# Other options: anthropic/claude-opus-4-5  anthropic/claude-haiku-4-5
#
# ---- Google Gemini ---------------------------------------------------------
# GEMINI_API_KEY=
# OPENCLAW_DEFAULT_MODEL=gemini/gemini-2.0-flash
# Other options: gemini/gemini-2.5-pro  gemini/gemini-2.5-flash
#
# ---- OpenAI ----------------------------------------------------------------
# OPENAI_API_KEY=
# OPENCLAW_DEFAULT_MODEL=openai/gpt-4o
# Other options: openai/gpt-4o-mini  openai/o3  openai/o4-mini
#
# ---- Amazon Bedrock --------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# OPENCLAW_DEFAULT_MODEL=bedrock/anthropic.claude-sonnet-4-5-v1:0
# Other options:
#   bedrock/amazon.nova-pro-v1:0
#   bedrock/meta.llama3-70b-instruct-v1:0
#   bedrock/anthropic.claude-haiku-4-5-v1:0
#
# ---- Ollama (local, host machine) ------------------------------------------
# Requires Ollama running on the Mac host. Model must be pulled first:
#   ollama pull llama3.3
# docker-compose.runtime.yml already adds extra_hosts host.docker.internal.
# OLLAMA_HOST=http://host.docker.internal:11434
# OPENCLAW_DEFAULT_MODEL=ollama/llama3.3
# Other options: ollama/qwen3  ollama/mistral  ollama/deepseek-r1
#
# ── OPTIONAL ────────────────────────────────────────────────────────────────

# ── Heartbeat (runtime-efficiency knobs) ─────────────────────────────────────
# The default agent self-wakes on a background "heartbeat". Vanilla openclaw
# runs it every 30m and reloads the FULL session transcript each time, which
# re-writes the prompt cache on every wake — the dominant token-cost driver on
# a 24/7 bot. These knobs (read by scripts/runtime-entrypoint.sh) rein it in.
# They SEED the config; a live `openclaw config set agents.defaults.heartbeat …`
# overrides them and persists. Leaving them unset still gives cheap defaults
# (isolated + light context, skip-when-busy, 2h) so no bot runs the 30m
# full-context loop. See scripts/claw-spend for the per-bot spend report.
#
# activeHours gates ONLY the autonomous heartbeat — the bot still answers your
# Telegram messages 24/7. A daytime window == the bot "sleeps" overnight.
#
# STANDING DECISION (2026-07-13): the autonomous heartbeat is OFF fleet-wide.
# The daily rhythm is driven entirely by openclaw cron (memory-core dreaming +
# sleep-cycle deep-sleep) until we ship a proxy-signal monitor that only wakes
# the agent when something actually warrants it. openclaw has no persistent
# heartbeat-off switch (its schema has no `enabled` field; removing the block
# falls through to a vanilla 30m loop; the runtime `system heartbeat disable`
# needs a paired scope boot tokens lack). So the entrypoint keeps it off the
# reliable way: it writes an "effectively empty" HEARTBEAT.md, and openclaw
# skips the heartbeat LLM call whenever that file has no real tasks
# (skipReason=empty-heartbeat-file). NOTE: openclaw's DEFAULT HEARTBEAT.md
# template is NOT empty (its "## Related" footer link fires a wake every
# time) — this is why we overwrite it. Flip to 0 to stop managing the file and
# let the seeded cadence below drive wakes:
#
#   OASIS_HEARTBEAT_DISABLED=1              # 1 (default) = heartbeat OFF at runtime
#
# The knobs below still SEED the cadence in config (the ready cadence for when
# heartbeats are re-enabled) but do nothing while OASIS_HEARTBEAT_DISABLED=1.
#
#   OASIS_HEARTBEAT_EVERY=5h                # duration; default unit = minutes
#   OASIS_HEARTBEAT_ACTIVE_START=06:30      # HH:MM 24h (set both start+end to enable)
#   OASIS_HEARTBEAT_ACTIVE_END=22:30        # HH:MM 24h (or 24:00 for end-of-day)
#   OASIS_HEARTBEAT_ACTIVE_TZ=America/New_York
#   OASIS_HEARTBEAT_ISOLATED=1              # heartbeat runs with no prior transcript
#   OASIS_HEARTBEAT_LIGHT_CONTEXT=1         # bootstrap only HEARTBEAT.md
#   OASIS_HEARTBEAT_SKIP_WHEN_BUSY=1        # defer while other work is running
#
# Fleet default (entrypoint fallback if unset): EVERY=5h, ACTIVE 06:30–22:30 ET
# — ~4 pulses/day (≈morning/midday/afternoon/evening), overnight sleep 22:30–06:30.
# NOTE: openclaw's heartbeat is interval + hash-phase, NOT clock-pinned — pulses
# land ~5h apart inside the window, not exactly on the hour. For exact wall-clock
# times you'd use cron jobs instead of the heartbeat.

# ── Sleep cycle (extensions/sleep-cycle — default ON at install) ────────────
# The deep-sleep RESET is openclaw's OWN native session reset (no cron, no tool,
# no operator.admin scope): it archives the long-lived conversation transcript
# and starts a fresh session on a daily boundary — the prompt-cache cost fix,
# done the framework's way. The entrypoint seeds it under
# session.resetByType.direct = {mode:"daily", atHour:N}. The sleep-cycle plugin
# rides that reset via a `before_reset` hook that stages a waking summary
# (handoff tail + vector-ranked memories), injected into the fresh session by a
# memory-prompt supplement. The dream step is memory-core's own 22:20 cron.
#
#   OASIS_SLEEP_ENABLED=1            # 0 disables the plugin + the reset seed
#   OASIS_SESSION_RESET_HOUR=23      # daily reset boundary, local hour 0–23.
#                                    # 23 (11 PM) = the day's context is held
#                                    # through all waking hours and rolls over at
#                                    # night, right after the 22:20 dream (the
#                                    # boundary must sit AFTER the dream so the
#                                    # day is consolidated before it's archived).
#                                    # Reset is LAZY (fires on the next message
#                                    # after the boundary), not a wall-clock job:
#                                    # an inactive-overnight bot effectively
#                                    # resets at its first morning message. Set
#                                    # low (e.g. 4) to reset in the morning
#                                    # instead. Applies to the BASE session.reset
#                                    # (covers the main session, where DMs run
#                                    # under the default dmScope:"main").
#   OASIS_SLEEP_TZ=America/New_York  # timezone for the waking-summary morning gate
#
# There is also a `sleep_deep` TOOL for MANUAL on-demand resets (e.g. relieving
# a rate limit mid-day) — ask the bot to run it. It needs operator.admin to
# drive sessions.reset (fine on an approved bot; a manual-only limitation on a
# fresh one — the AUTOMATIC native reset above needs no scope). The entrypoint
# seeds tools.alsoAllow:["sleep_deep"] so the restrictive `coding` tool profile
# doesn't strip the tool before the agent can call it. You don't set that by
# hand. Fine-grained knobs (sessionMatch, waking-summary size) live in
# plugins.entries.sleep-cycle.config — see the manifest.

# ── GitHub access (per-bot, scoped) ──────────────────────────────────────────
# Each bot that manages repos carries its OWN fine-grained PAT here, minted in
# the GitHub UI (Settings → Developer settings → Fine-grained tokens) scoped to
# just this bot's repos + permissions. Don't hand-edit these — use the manager:
#   ./scripts/claw-git set <bot>          # prompts for the PAT (no echo), recreates, verifies
#   ./scripts/claw-git list [--probe]     # per-bot overview / live check
#   ./scripts/claw-git repos <bot> --add owner/repo
#   ./scripts/claw-git rotate <bot>       # opens the PAT page, then stores it
# See .swarm/GIT_ACCESS_RUNBOOK.md for the full minting + branch-protection steps.
#
# PRIMARY = GitHub App (CLI-minted, short-lived per-repo tokens). Set up once
# (see the runbook), then `./scripts/claw-git app-init` + `app-set <bot>`. In App
# mode the image helper mints tokens on demand — you don't hand-edit these:
#   GH_APP_ID=123456                 # the shared "Oasis Claw Bots" App id
#   GH_APP_PRIVATE_KEY_B64=...       # base64 of the App private-key PEM
#   GH_APP_INSTALLATION_ID=...       # optional; looked up per-repo if unset
#
# FALLBACK = fine-grained PAT (UI-minted). If GH_APP_ID is unset but GH_TOKEN is:
#   GH_TOKEN=github_pat_...          # the per-bot fine-grained PAT (gh reads it from env)
#   OASIS_GIT_REPOS=owner/a owner/b  # PUSH allowlist (space-sep). '*' = all (Yes Man);
#                                    # unset = pushes governed by PAT scope only.
#                                    # Reads are NOT restricted (public read stays open,
#                                    # e.g. Van Helsing). owner/* wildcard is allowed.
#   OASIS_GIT_USER_NAME=ButterBolt (oasis-claw)   # git commit identity (log provenance)
#   OASIS_GIT_USER_EMAIL=butterbolt@oasis-x.io
#
# Guardrail: the runtime image shadows `git` with a wrapper + a global pre-push
# hook that HARD-REFUSE history-destroying ops (force-push, --force-with-lease,
# ref-delete, colon/plus refspecs) and out-of-scope pushes — so rollbacks are
# always possible. It fails OPEN (never breaks normal git); the real server-side
# guarantees are the PAT scope + GitHub branch protection (you set the latter).
# No boot-time GitHub call, so an egress-locked bot (Van Helsing) still starts —
# but note it can only REACH github if its egress allowlist permits it.

# Set to 1 to print the full gateway token in container startup banner.
# OASIS_SHOW_TOKEN=0

# Pin openclaw version (default comes from Dockerfile ARG).
# OPENCLAW_VERSION=2026.4.26

# clawhub-skill-audit: ANTHROPIC_API_KEY above is reused for the auditor
# (Opus 4.7 by default). To enable the destructive policy — move skills with
# verdict=block out of the active skills dir — set a quarantine path.
# Without it the plugin is audit-only (logs + Telegram alert, never moves files).
# OASIS_SKILL_AUDIT_QUARANTINE_DIR=/home/node/.openclaw/quarantine/skills
