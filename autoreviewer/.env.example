# Copy to autoreviewer/.env (gitignored) and fill in.
# Your Telegram user ID: the only account whose button presses and commands count.
AUTOREVIEWER_OWNER_ID=
# Optional: a different chat for the cards. Default: your DM with the bot.
AUTOREVIEWER_CHAT_ID=
# Fleet bot names (the mail relay's names), comma-separated.
AUTOREVIEWER_BOTS=
# Optional: grant TTL buttons in hours, at most 24.
AUTOREVIEWER_TTL_BUTTONS=1,4,24
# Optional: the mail route file (default ../scripts/claw-mail-routes.json).
AUTOREVIEWER_MAIL_ROUTES_FILE=
