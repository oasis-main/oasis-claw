# secrets bucket — packed into one tarball, age-encrypted to secrets.tar.age,
# committed alongside the text bucket. The recipient pubkey is read from
# OASIS_STATE_AGE_RECIPIENTS (or ~/.config/oasis-state/recipients). The
# matching private key MUST live outside the state repo on each host.
#
# Decrypts to nothing if the private key is missing — so committing this to
# a public repo would only leak the existence and rough size of secrets.

# Device identity (private key for inter-device pairing)
identity/device.json
identity/device-auth.json

# Model auth (Anthropic/OpenAI API keys per profile + refresh tokens)
agents/main/agent/auth-profiles.json
agents/main/agent/auth-state.json

# gog OAuth keyring (Gmail/Calendar/Drive/etc.)
config/gogcli/**
