#!/usr/bin/env python3
"""
claw-exec-approve — Telegram-independent exec approval transport.

WHY

openclaw 6.11's exec approval UI has two documented paths (button tap →
callback_query, DM slash command → text), but only the first works — see
CLAW-070 (parseExecApprovalCommandText is never called on inbound message
text, only on callback_query.data). And in practice we've seen the
button-tap path go silent for reasons we haven't fully nailed down (session
rebind, Telegram polling stall, or callback delivery quirk — pending_update
was 0 with no visible callback traffic on both mobile and web taps at
2026-07-23 20:02–20:07 UTC).

This script gives an OUT-OF-BAND transport: it calls the gateway RPC
`exec.approval.resolve` directly via the same headless client pattern
claw-approve-v2 uses for device pairing (callGatewayFromCli with
deviceIdentity=null, clientName=gateway-client, mode=backend, gateway token
from the bot's own openclaw.json).

No Telegram round-trip. No 30-min window race. Approve or deny from the
same terminal you'd read the log from.

USAGE

  claw-exec-approve <bot> <approval-id> [decision]

  decision defaults to allow-once. Accepted values: allow-once, allow-always, deny.

  Approval id comes from the Telegram card (the "Full id" field) or from
  the pending_command list emitted by openclaw internals.

SAFETY

  • Same "gateway token = ephemeral scope elevation" invariant as v2 —
    no standing operator.approvals credential is materialized on any
    persistent device.
  • DECISION MUST BE EXPLICIT — no interactive prompt, no default
    behavior on stdin; you type the decision or the tool refuses.
  • Only resolves ONE approval at a time; no batch/wildcard.

CROSS-REFS: CLAW-058 (unblock), CLAW-070 (DM parser gap), CLAW-068
(Telegram callback fragility), CLAW-066 (proper approval-runtime process).
"""

import argparse
import json
import subprocess
import sys

VALID_DECISIONS = ("allow-once", "allow-always", "deny")


def container(bot):
    return f"oasis-claw-{bot}"


def gateway_token(bot):
    out = subprocess.run(
        ["docker", "exec", container(bot), "python3", "-c",
         "import json;print(json.load(open('/home/node/.openclaw/openclaw.json'))"
         "['gateway']['auth']['token'])"],
        capture_output=True, text=True, timeout=30,
    )
    tok = out.stdout.strip()
    if not tok:
        raise SystemExit(
            f"[claw-exec-approve] no gateway token in {container(bot)}: "
            f"{out.stderr.strip()[:200]}"
        )
    return tok


# Identical headless RPC harness to claw-approve-v2 — same escape from
# trap-2, same reasons (deviceIdentity=null bypasses device-scope checks;
# clientName=gateway-client + mode=backend gates shouldSkipLocalBackend
# SelfPairing so requested scopes are honored instead of dropped).
_NODE_HEADLESS_RPC = r"""
import { callGatewayFromCli } from 'file:///usr/local/lib/node_modules/openclaw/dist/plugin-sdk/gateway-runtime.js';

const method     = process.env.RPC_METHOD;
const paramsJson = process.env.RPC_PARAMS;
const scopesJson = process.env.RPC_SCOPES;
const token      = process.env.GWT;
if (!token || !method || !paramsJson || !scopesJson) {
  console.error('missing env: need GWT, RPC_METHOD, RPC_PARAMS, RPC_SCOPES');
  process.exit(2);
}
try {
  const result = await callGatewayFromCli(
    method,
    { url: 'ws://127.0.0.1:18789', token, json: true, timeout: '15000' },
    JSON.parse(paramsJson),
    {
      deviceIdentity: null,
      clientName: 'gateway-client',
      mode: 'backend',
      scopes: JSON.parse(scopesJson),
      progress: false,
    }
  );
  process.stdout.write(JSON.stringify(result ?? {}));
} catch (err) {
  console.error(err && err.message ? err.message : String(err));
  process.exit(1);
}
"""


def call_gateway_headless(bot, token, method, params, scopes):
    out = subprocess.run(
        ["docker", "exec", "-i",
         "-e", f"GWT={token}",
         "-e", f"RPC_METHOD={method}",
         "-e", f"RPC_PARAMS={json.dumps(params)}",
         "-e", f"RPC_SCOPES={json.dumps(list(scopes))}",
         container(bot),
         "node", "--input-type=module", "-e", _NODE_HEADLESS_RPC],
        capture_output=True, text=True, timeout=45,
    )
    if out.returncode != 0:
        err = (out.stderr or out.stdout).strip()
        raise RuntimeError(f"headless RPC failed ({method}): {err[:500]}")
    try:
        return json.loads(out.stdout.strip() or "{}")
    except json.JSONDecodeError:
        raise RuntimeError(
            f"headless RPC returned non-JSON ({method}): {out.stdout[:300]}"
        )


def main():
    ap = argparse.ArgumentParser(description="Resolve an openclaw exec approval out-of-band.")
    ap.add_argument("bot", help="bot short-name (yesman, vanhelsing, …)")
    ap.add_argument("approval_id",
                    help="the Full id shown on the Telegram approval card")
    ap.add_argument("decision", nargs="?", default="allow-once",
                    choices=VALID_DECISIONS,
                    help=f"one of {VALID_DECISIONS} (default: allow-once)")
    args = ap.parse_args()

    token = gateway_token(args.bot)
    print(
        f"[claw-exec-approve] resolving approval {args.approval_id} "
        f"with decision={args.decision} on {args.bot}"
    )
    result = call_gateway_headless(
        args.bot, token, "exec.approval.resolve",
        {"id": args.approval_id, "decision": args.decision},
        # Caller-side scope MUST be operator.admin, not operator.approvals.
        # Exec approvals are device-bound to the requester: isApprovalRecord
        # VisibleToClient (approval-shared-DSFYVdQ3.js:59) checks
        # `requestedByDeviceId === clientDeviceId` — but our headless RPC
        # connects with deviceIdentity=null, so clientDeviceId is null and
        # the device match fails → record reported "unknown or expired".
        # operator.admin trips the gate's FIRST clause
        # (`if scopes.includes("operator.admin") return true`) which bypasses
        # the device check entirely. Same escape claw-approve-v2's approve()
        # uses. operator.approvals alone is NOT sufficient here (verified live
        # 2026-07-23 20:12 — resolve failed "unknown or expired approval id").
        ["operator.admin"],
    )
    print(f"[claw-exec-approve] resolved: {json.dumps(result)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
