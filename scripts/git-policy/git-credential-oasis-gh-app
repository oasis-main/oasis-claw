#!/usr/bin/env python3
"""
git-credential-oasis-gh-app — GitHub App credential helper for the oasis-claw
fleet. Mints a SHORT-LIVED (1h), per-repo-scoped installation token on demand
from the App private key, so a 24/7 bot never holds a long-lived token and every
token is centrally revocable (roll the App key / uninstall the App).

Configured in the entrypoint (App mode) as:
    git config --global credential.https://github.com.helper oasis-gh-app
    git config --global credential.https://github.com.useHttpPath true   # so we get owner/repo
git then invokes `git-credential-oasis-gh-app get` with the request on stdin.

Env (set per bot by claw-git; the App id + key are shared across the fleet):
    GH_APP_ID                 numeric App id
    GH_APP_PRIVATE_KEY_B64    base64 of the App private-key PEM (.env-friendly)
    GH_APP_PRIVATE_KEY        raw PEM (alternative to _B64)
    GH_APP_INSTALLATION_ID    optional; looked up per-repo if unset
    OASIS_GIT_REPOS           push/scope allowlist; used to down-scope the token
                              to the single repo being accessed ('*' = no restrict)

Fails SILENTLY (emits nothing, exit 0) on any error so git falls back to
anonymous access rather than hard-erroring — matches the fail-open guardrail
posture. RS256 signing uses the openssl CLI (no third-party python deps).
"""
import base64
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.request

API = "https://api.github.com"
CACHE_DIR = os.environ.get("OASIS_GH_APP_CACHE", "/tmp/.gh-app-tokens")


def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def read_request() -> dict:
    req = {}
    for line in sys.stdin:
        line = line.strip()
        if not line:
            break
        if "=" in line:
            k, v = line.split("=", 1)
            req[k] = v
    return req


def load_pem() -> bytes | None:
    b64 = os.environ.get("GH_APP_PRIVATE_KEY_B64", "").strip()
    if b64:
        try:
            return base64.b64decode(b64)
        except Exception:
            return None
    raw = os.environ.get("GH_APP_PRIVATE_KEY", "").strip()
    return raw.encode() if raw else None


def make_jwt(app_id: str, pem: bytes) -> str | None:
    now = int(time.time())
    header = b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    # iat backdated 60s for clock skew; exp 9min (GitHub max 10).
    payload = b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": app_id}).encode())
    signing_input = f"{header}.{payload}".encode()
    tf = None
    try:
        tf = tempfile.NamedTemporaryFile(delete=False, dir="/tmp")
        os.chmod(tf.name, 0o600)
        tf.write(pem)
        tf.close()
        sig = subprocess.run(
            ["openssl", "dgst", "-sha256", "-sign", tf.name],
            input=signing_input, capture_output=True, check=True,
        ).stdout
        return f"{header}.{payload}.{b64url(sig)}"
    except Exception:
        return None
    finally:
        if tf:
            try:
                os.unlink(tf.name)
            except OSError:
                pass


def api_get(path: str, token: str, app_jwt: bool = False):
    req = urllib.request.Request(API + path)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("User-Agent", "oasis-claw-gh-app")
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def api_post(path: str, token: str, body: dict):
    data = json.dumps(body).encode()
    req = urllib.request.Request(API + path, data=data, method="POST")
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("User-Agent", "oasis-claw-gh-app")
    req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def repo_from_request(req: dict) -> str | None:
    """owner/repo from the credential 'path' (e.g. oasis-main/bounty_hunter.git)."""
    path = req.get("path", "")
    if not path:
        return None
    slug = path.strip("/")
    if slug.endswith(".git"):
        slug = slug[:-4]
    parts = slug.split("/")
    return f"{parts[0]}/{parts[1]}" if len(parts) >= 2 else None


def in_allowlist(repo: str) -> bool:
    allow = (os.environ.get("OASIS_GIT_REPOS", "") or "").replace(",", " ").split()
    if not allow or "*" in allow:
        return True
    rl = repo.lower()
    for e in allow:
        el = e.lower()
        if el == rl or (el.endswith("/*") and rl.startswith(el[:-1])):
            return True
    return False


def cache_path(key: str) -> str:
    h = hashlib.sha256(key.encode()).hexdigest()[:16]
    return os.path.join(CACHE_DIR, h + ".json")


def get_cached(key: str) -> str | None:
    try:
        with open(cache_path(key)) as f:
            c = json.load(f)
        # refresh if <5 min left
        if c.get("exp", 0) - time.time() > 300:
            return c["token"]
    except Exception:
        pass
    return None


def put_cached(key: str, token: str, expires_at: str):
    try:
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
        # expires_at like 2026-07-14T21:00:00Z
        exp = time.mktime(time.strptime(expires_at, "%Y-%m-%dT%H:%M:%SZ"))
        p = cache_path(key)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"token": token, "exp": exp}, f)
    except Exception:
        pass


def mint() -> str | None:
    app_id = os.environ.get("GH_APP_ID", "").strip()
    pem = load_pem()
    if not app_id or not pem:
        return None
    req = read_request()
    if req.get("host") != "github.com":
        return None
    repo = repo_from_request(req)
    scope_repo = repo if (repo and in_allowlist(repo)) else None

    inst = os.environ.get("GH_APP_INSTALLATION_ID", "").strip()
    cache_key = f"{app_id}:{inst or 'auto'}:{scope_repo or 'all'}"
    cached = get_cached(cache_key)
    if cached:
        return cached

    jwt = make_jwt(app_id, pem)
    if not jwt:
        return None

    # Resolve installation id from the repo if not pinned.
    if not inst and repo:
        try:
            inst = str(api_get(f"/repos/{repo}/installation", jwt)["id"])
        except Exception:
            return None
    if not inst:
        return None

    body: dict = {}
    if scope_repo:
        body["repositories"] = [scope_repo.split("/", 1)[1]]
    try:
        resp = api_post(f"/app/installations/{inst}/access_tokens", jwt, body)
    except Exception:
        return None
    token = resp.get("token")
    if token:
        put_cached(cache_key, token, resp.get("expires_at", ""))
    return token


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action != "get":
        return  # store/erase: nothing to persist (tokens are ephemeral)
    try:
        token = mint()
    except Exception:
        token = None
    if token:
        sys.stdout.write("protocol=https\nhost=github.com\n")
        sys.stdout.write("username=x-access-token\n")
        sys.stdout.write(f"password={token}\n")


if __name__ == "__main__":
    main()
