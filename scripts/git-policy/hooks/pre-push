#!/usr/bin/env bash
# oasis-claw pre-push backstop — installed globally via core.hooksPath.
#
# Second line of defence behind the `git` wrapper (scripts/git-policy/git-guard.sh):
# rejects the two rollback-destroying push shapes even when git is invoked
# directly as /usr/bin/git (bypassing the wrapper). It canNOT be reached if a
# caller passes --no-verify to the real git binary — that is why the wrapper
# strips --no-verify, and why server-side branch protection remains the actual
# guarantee.
#
# git feeds us, on stdin, one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# A delete has an all-zero local sha. A non-fast-forward (force) has a non-zero
# remote sha that is NOT an ancestor of the local sha.

set -u
ZERO='0000000000000000000000000000000000000000'
REAL_GIT=/usr/bin/git
rc=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  # Deleting a remote ref (push :ref / --delete) — blocked.
  if [ "$local_sha" = "$ZERO" ]; then
    printf '✋ oasis-git-policy (pre-push): refusing to DELETE remote ref %s — rollback-safe by policy.\n' "$remote_ref" >&2
    rc=1; continue
  fi

  # Updating an existing remote ref non-fast-forward (force) — blocked.
  if [ "$remote_sha" != "$ZERO" ]; then
    if ! "$REAL_GIT" merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      printf '✋ oasis-git-policy (pre-push): refusing NON-FAST-FORWARD push to %s (would overwrite remote history).\n' "$remote_ref" >&2
      rc=1; continue
    fi
  fi
done

exit "$rc"
