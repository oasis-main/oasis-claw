#!/usr/bin/env python3
"""
git-credential-oasis-gh-file — serves a GitHub token minted on the Mac
(scripts/claw-gh-minter, Mike 2026-10-08) to git inside a bot.

The minter writes one 1-hour installation token per GitHub account into the
bot's own folder, mounted read-only at /run/oasis-gh:
    /run/oasis-gh/<account, lower case>.json   {"token", "expires_at", ...}
The bot never holds an App key or a long-lived token.

Configured by the entrypoint when /run/oasis-gh exists:
    git config --global credential.https://github.com.helper oasis-gh-file
    git config --global credential.https://github.com.useHttpPath true
With useHttpPath, git sends path=<owner>/<repo>, so the helper picks the
token for that owner. Without a path it uses the only token, if there is one.

Fails silently (prints nothing, exit 0) when there is no usable token, so
git falls back to anonymous access, as the other oasis helpers do.
"""
import calendar
import json
import os
import sys
import time

TOKEN_DIR = os.environ.get("OASIS_GH_TOKEN_DIR", "/run/oasis-gh")


def usable(path):
    try:
        with open(path) as f:
            rec = json.load(f)
        exp = calendar.timegm(time.strptime(rec["expires_at"], "%Y-%m-%dT%H:%M:%SZ"))
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return rec["token"] if exp - time.time() > 60 else None


def token_for(owner):
    if owner:
        return usable(os.path.join(TOKEN_DIR, f"{owner.lower()}.json"))
    try:
        files = [n for n in os.listdir(TOKEN_DIR) if n.endswith(".json")]
    except OSError:
        return None
    return usable(os.path.join(TOKEN_DIR, files[0])) if len(files) == 1 else None


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return 0  # store / erase: the token lives on the Mac; nothing to do
    fields = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        k, _, v = line.partition("=")
        fields[k] = v
    if fields.get("host", "github.com") != "github.com":
        return 0
    path = fields.get("path", "")
    owner = path.split("/", 1)[0] if "/" in path else ""
    token = token_for(owner)
    if token:
        sys.stdout.write(f"protocol=https\nhost=github.com\nusername=x-access-token\npassword={token}\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
