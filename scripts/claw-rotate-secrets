#!/usr/bin/env python3
"""
claw-rotate-secrets — rotate each bot's gateway token and oasis-generation key,
and remove the old copies from the config backups (VH-002, VH-005).

Never prints a secret. Values show only as the first 10 hex digits of their
SHA-256, which is how the Van Helsing audit and the fleet probe name them.

  scripts/claw-rotate-secrets probe [bot ...]   fingerprint every config copy + env
  scripts/claw-rotate-secrets gen-add           phase 1: mint a new oasis-generation
                                                key per bot, write it to the bot's
                                                .env, and make the gateway accept
                                                old AND new (no bot loses models)
  scripts/claw-rotate-secrets bot <bot>         new gateway token + recreate the bot
                                                with its own labelled compose files
                                                + replace its config backups
  scripts/claw-rotate-secrets gen-prune         phase 2: the gateway accepts only
                                                the key in each bot's .env

Order: gen-add, then `bot` for every bot, then gen-prune. A bot recreated
before gen-add keeps its old key; gen-prune would then lock it out, so
gen-prune refuses while any running bot still presents a key that is not the
one in its .env.

Requires the image built from 530abcc or later (the entrypoint writes
SecretRefs). `bot` refuses to touch the backups if the live config still holds
a literal, since copying it over the backups would spread the value again.
"""

import hashlib
import json
import re
import secrets
import subprocess
import sys
import time
from pathlib import Path

CLAW = Path(__file__).resolve().parent.parent
GEN_DIR = CLAW.parent / "oasis-generation" / "docker"
GEN_ENV = GEN_DIR / ".env"

# bot -> (container, env file holding its OASIS_GENERATION_TOKEN)
BOTS = {
    "nimbus": ("oasis-claw-runtime", CLAW / ".env"),
    "house": ("oasis-claw-house", CLAW / "bots/house/.env"),
    "kolmogorov": ("oasis-claw-kolmogorov", CLAW / "bots/kolmogorov/.env"),
    "vanhelsing": ("oasis-claw-vanhelsing", CLAW / "bots/vanhelsing/.env"),
    "yesman": ("oasis-claw-yesman", CLAW / "bots/yesman/.env"),
    "butterbolt": ("oasis-claw-butterbolt", CLAW / "bots/butterbolt/.env"),
    "hello-world": ("oasis-claw-hello-world", CLAW / "bots/hello-world/.env"),
}
# Bots on the oasis_sandboxed network: the egress proxy maps them by source IP,
# which a recreate can change.
SANDBOXED = {"house", "kolmogorov", "vanhelsing", "yesman", "butterbolt"}
HOME = "/home/node/.openclaw"
# claw-vet reads OASIS_GENERATION_TOKEN from the root .env, which is Nimbus's
# key, so it must be recreated with Nimbus or gen-prune locks it out.
VET = "oasis-claw-vet"


def fp(v):
    return hashlib.sha256(v.encode()).hexdigest()[:10]


def die(msg):
    sys.exit(f"[claw-rotate-secrets] {msg}")


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


# ── .env editing: replace exactly one KEY= line, keep everything else ─────────

def env_get(path, key):
    vals = [l.partition("=")[2].strip().strip("'\"") for l in path.read_text().splitlines()
            if re.match(rf"^\s*{key}\s*=", l)]
    if len(vals) != 1:
        die(f"{path}: expected exactly one {key}= line, found {len(vals)}")
    return vals[0]


def env_set(path, key, value):
    lines = path.read_text().splitlines(keepends=True)
    hits = [i for i, l in enumerate(lines) if re.match(rf"^\s*{key}\s*=", l)]
    if len(hits) != 1:
        die(f"{path}: expected exactly one {key}= line, found {len(hits)}")
    lines[hits[0]] = f"{key}={value}\n"
    path.write_text("".join(lines))


def service_tokens():
    """[(name, token)] from the gateway's OASIS_GENERATION_SERVICE_TOKENS."""
    out = []
    for item in env_get(GEN_ENV, "OASIS_GENERATION_SERVICE_TOKENS").split(","):
        item = item.strip()
        if not item:
            continue
        name, sep, tok = item.partition(":")
        out.append((name.strip(), tok.strip()) if sep else ("", item))
    return out


def write_service_tokens(pairs):
    env_set(GEN_ENV, "OASIS_GENERATION_SERVICE_TOKENS",
            ",".join(f"{n}:{t}" if n else t for n, t in pairs))


def recreate_gateway():
    r = run(["docker", "compose", "-f", str(GEN_DIR / "docker-compose.yml"),
             "up", "-d", "--no-deps", "--force-recreate", "gateway"], cwd=GEN_DIR)
    if r.returncode:
        die(f"gateway recreate failed: {r.stderr.strip()[-400:]}")
    print("[gateway] recreated")


def container_env_fp(container, key):
    r = run(["docker", "inspect", container, "--format", "{{json .Config.Env}}"])
    if r.returncode:
        return None
    for kv in json.loads(r.stdout):
        k, _, v = kv.partition("=")
        if k == key:
            return fp(v)
    return None


# ── phases ───────────────────────────────────────────────────────────────────

def gen_add():
    pairs = service_tokens()
    names = {n for n, _ in pairs}
    missing = [b for b in BOTS if b not in names]
    if missing:
        die(f"gateway has no entry for {missing}; refusing to guess")
    for bot, (_, env_path) in BOTS.items():
        new = secrets.token_urlsafe(32)
        env_set(env_path, "OASIS_GENERATION_TOKEN", new)
        pairs.append((bot, new))
        print(f"[gen-add] {bot}: new key {fp(new)} -> {env_path.relative_to(CLAW.parent)}")
    write_service_tokens(pairs)
    recreate_gateway()
    print("[gen-add] gateway now accepts old and new keys; recreate each bot next")


def gen_prune():
    current = {bot: env_get(p, "OASIS_GENERATION_TOKEN") for bot, (_, p) in BOTS.items()}
    stale = [b for b, (c, _) in BOTS.items()
             if container_env_fp(c, "OASIS_GENERATION_TOKEN") != fp(current[b])]
    vet_fp = container_env_fp(VET, "OASIS_GENERATION_TOKEN")
    if vet_fp is not None and vet_fp != fp(current["nimbus"]):
        stale.append(VET)
    if stale:
        die(f"still presenting a key that is not in their .env: {stale} — run `bot` for them first")
    kept, dropped = [], []
    for n, t in service_tokens():
        (kept if current.get(n) == t else dropped).append((n, t))
    for n, t in dropped:
        print(f"[gen-prune] drop {n or '(unattributed)'} {fp(t)}")
    write_service_tokens(kept)
    recreate_gateway()
    print(f"[gen-prune] gateway accepts {len(kept)} keys, one per bot")


# In-container: replace every backup copy with secret-free content. Runs as
# uid node, prints file names and actions only.
SANITIZE_JS = r"""
const fs = require("fs"), path = require("path");
const H = "/home/node/.openclaw", live = path.join(H, "openclaw.json");
const isRef = (v) => v && typeof v === "object" && typeof v.source === "string";
const cfg = JSON.parse(fs.readFileSync(live, "utf8"));
const gw = cfg?.gateway?.auth?.token;
const key = cfg?.models?.providers?.["oasis-generation"]?.apiKey;
if (!isRef(gw) || (key !== undefined && !isRef(key))) {
  console.log(JSON.stringify({ abort: "live openclaw.json still holds a literal; old image?" }));
  process.exit(3);
}
const raw = fs.readFileSync(live, "utf8");
const ring = new Set(["openclaw.json.bak", "openclaw.json.bak.1", "openclaw.json.bak.2",
  "openclaw.json.bak.3", "openclaw.json.bak.4", "openclaw.json.last-good"]);
const out = [];
for (const n of fs.readdirSync(H).sort()) {
  if (!n.startsWith("openclaw.json.")) continue;
  const p = path.join(H, n);
  if (ring.has(n)) { fs.writeFileSync(p, raw, { mode: 0o600 }); fs.chmodSync(p, 0o600); out.push([n, "replaced with live"]); continue; }
  let j;
  try { j = JSON.parse(fs.readFileSync(p, "utf8")); } catch { out.push([n, "UNPARSEABLE, left as is"]); continue; }
  const done = [];
  if (typeof j?.gateway?.auth?.token === "string") { j.gateway.auth.token = gw; done.push("gateway"); }
  for (const [name, prov] of Object.entries(j?.models?.providers || {})) {
    if (typeof prov?.apiKey !== "string" || prov.apiKey === "anonymous") continue;
    prov.apiKey = name === "oasis-generation"
      ? { source: "env", provider: "default", id: "OASIS_GENERATION_TOKEN" } : "REDACTED-2026-10-08";
    done.push(name);
  }
  const tg = j?.channels?.telegram;
  if (typeof tg?.botToken === "string" && tg.botToken) {
    tg.botToken = { source: "env", provider: "default", id: "OASIS_TELEGRAM_BOT_TOKEN" }; done.push("telegram");
  }
  if (done.length) { fs.writeFileSync(p, JSON.stringify(j, null, 2) + "\n", { mode: 0o600 }); fs.chmodSync(p, 0o600); }
  out.push([n, done.length ? "refs: " + done.join(",") : "no literals"]);
}
console.log(JSON.stringify({ files: out }));
"""

PROBE_JS = r"""
const fs = require("fs"), path = require("path"), c = require("crypto");
const fp = (v) => c.createHash("sha256").update(String(v)).digest("hex").slice(0, 10);
const show = (v) => typeof v === "string" ? (v === "anonymous" ? "anonymous" : fp(v)) : v ? "ref" : "-";
const H = "/home/node/.openclaw", out = [];
for (const n of fs.readdirSync(H).sort()) {
  const p = path.join(H, n);
  if (n === ".gateway-token") { out.push(`${n}=${fp(fs.readFileSync(p, "utf8").trim())}`); continue; }
  if (!n.startsWith("openclaw.json")) continue;
  try {
    const j = JSON.parse(fs.readFileSync(p, "utf8"));
    const keys = Object.entries(j?.models?.providers || {}).map(([k, v]) => `${k}:${show(v?.apiKey)}`);
    out.push(`${n} gw=${show(j?.gateway?.auth?.token)} tg=${show(j?.channels?.telegram?.botToken)} ${keys.join(" ")}`);
  } catch { out.push(`${n} UNPARSEABLE`); }
}
console.log(out.join("\n"));
"""


def node_in(container, script):
    return run(["docker", "exec", "-i", "-u", "node", container, "node", "-"],
               input=script, timeout=60)


def probe(bots):
    for bot in bots or BOTS:
        container = BOTS[bot][0]
        r = node_in(container, PROBE_JS)
        print(f"== {bot} ({container}) env OASIS_GENERATION_TOKEN="
              f"{container_env_fp(container, 'OASIS_GENERATION_TOKEN')}")
        print(r.stdout.rstrip() or r.stderr.strip()[-300:])


def labelled_compose(container):
    r = run(["docker", "inspect", container, "--format",
             '{{index .Config.Labels "com.docker.compose.project"}}|'
             '{{index .Config.Labels "com.docker.compose.service"}}|'
             '{{index .Config.Labels "com.docker.compose.project.working_dir"}}|'
             '{{index .Config.Labels "com.docker.compose.project.config_files"}}'])
    if r.returncode:
        die(f"{container}: cannot read compose labels")
    project, service, wd, files = r.stdout.strip().split("|")
    cmd = ["docker", "compose", "-p", project]
    for f in files.split(","):
        cmd += ["-f", f]
    return cmd, service, wd


def wait_healthy(container, timeout=420):
    end = time.time() + timeout
    while time.time() < end:
        r = run(["docker", "inspect", container, "--format", "{{.State.Health.Status}}"])
        if r.stdout.strip() == "healthy":
            return
        time.sleep(5)
    die(f"{container} not healthy after {timeout}s")


def rotate_bot(bot):
    if bot not in BOTS:
        die(f"unknown bot {bot}; known: {', '.join(BOTS)}")
    container, env_path = BOTS[bot]
    if bot == "vanhelsing" and not (Path.home() / "Documents/Runes/pliny").is_dir():
        die("host ~/Documents/Runes/pliny is missing; VH's tmpfs shadow mount needs it (see memory note)")
    cmd, service, wd = labelled_compose(container)
    before = run(["docker", "exec", "-u", "node", container, "cat", f"{HOME}/.gateway-token"]).stdout.strip()
    r = run(["docker", "exec", "-u", "node", container, "rm", "-f", f"{HOME}/.gateway-token"])
    if r.returncode:
        die(f"{container}: could not remove .gateway-token: {r.stderr.strip()[:200]}")
    print(f"[{bot}] old gateway token {fp(before) if before else '-'} removed; recreating {service}")
    r = run(cmd + ["up", "-d", "--no-deps", "--force-recreate", service], cwd=wd)
    if r.returncode:
        die(f"{bot}: recreate failed: {r.stderr.strip()[-400:]}")
    wait_healthy(container)
    after = run(["docker", "exec", "-u", "node", container, "cat", f"{HOME}/.gateway-token"]).stdout.strip()
    if not after or after == before:
        die(f"{bot}: gateway token did not change")
    print(f"[{bot}] healthy; new gateway token {fp(after)}; "
          f"model key {container_env_fp(container, 'OASIS_GENERATION_TOKEN')}")
    r = node_in(container, SANITIZE_JS)
    print(f"[{bot}] backups: {r.stdout.strip() or r.stderr.strip()[-300:]}")
    if r.returncode:
        die(f"{bot}: backup clean-up refused (exit {r.returncode})")
    if bot == "nimbus" and container_env_fp(VET, "OASIS_GENERATION_TOKEN") is not None:
        vcmd, vservice, vwd = labelled_compose(VET)
        r = run(vcmd + ["up", "-d", "--no-deps", "--force-recreate", vservice], cwd=vwd)
        if r.returncode:
            die(f"claw-vet recreate failed: {r.stderr.strip()[-400:]}")
        print(f"[nimbus] claw-vet recreated; model key {container_env_fp(VET, 'OASIS_GENERATION_TOKEN')}")
    if bot in SANDBOXED:
        r = run(["make", "-C", str(CLAW / "bots"), "egress-sync"])
        print(f"[{bot}] egress-sync exit {r.returncode}")
        if r.returncode:
            die(f"egress-sync failed: {r.stderr.strip()[-300:]}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "probe":
        probe(rest)
    elif cmd == "gen-add":
        gen_add()
    elif cmd == "gen-prune":
        gen_prune()
    elif cmd == "bot" and len(rest) == 1:
        rotate_bot(rest[0])
    else:
        die(f"bad arguments: {' '.join(argv)}")


if __name__ == "__main__":
    main(sys.argv[1:])
