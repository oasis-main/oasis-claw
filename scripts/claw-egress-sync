#!/usr/bin/env python3
"""claw-egress-sync — regenerate the egress proxy's source-IP → bot CLIENT_MAP
from the LIVE container IPs on the sandboxed network (CLAW-050).

The per-bot egress partition keys on the client SOURCE IP. Container IPs can
change on recreate, so this writes the current mapping to CLIENT_MAP_FILE (in the
proxy's RO-mounted learned dir); the proxy hot-reloads it — no proxy recreate.

Run it after ANY sandboxed bot is recreated. A stale map is fail-safe (an
unmapped bot drops to base-only egress), never fail-open, but its vetted sources
would silently stop resolving until re-synced.

Usage: claw-egress-sync [--print]   (--print = show the map, don't write)

Env: OASIS_EGRESS_NETWORK (default oasis-claw_oasis_sandboxed),
     OASIS_EGRESS_LEARNED_DIR (default <repo>/sandbox/egress-proxy/learned).
"""
import json
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
NETWORK = os.environ.get("OASIS_EGRESS_NETWORK", "").strip() or "oasis-claw_oasis_sandboxed"
LEARNED_DIR = Path(
    os.environ.get("OASIS_EGRESS_LEARNED_DIR", "").strip()
    or (REPO / "sandbox" / "egress-proxy" / "learned")
)
MAP_FILE = LEARNED_DIR / "client.map"

# Only these are sandboxed bots we partition. Container name = oasis-claw-<bot>;
# the sidecars (voice/semantics) + the proxy are NOT bots and are skipped.
BOTS = {"vanhelsing", "yesman", "house", "kolmogorov", "butterbolt"}


def live_map():
    """{ip: bot} for every partitionable bot currently on the sandbox network."""
    try:
        raw = subprocess.run(
            ["docker", "network", "inspect", NETWORK],
            capture_output=True, text=True, timeout=15, check=True,
        ).stdout
    except (subprocess.SubprocessError, FileNotFoundError) as e:
        print(f"[claw-egress-sync] cannot inspect network {NETWORK}: {e}", file=sys.stderr)
        sys.exit(1)
    nets = json.loads(raw)
    if not nets:
        print(f"[claw-egress-sync] network {NETWORK} not found", file=sys.stderr)
        sys.exit(1)
    out = {}
    for cid, c in (nets[0].get("Containers") or {}).items():
        name = c.get("Name", "")
        if not name.startswith("oasis-claw-"):
            continue
        bot = name[len("oasis-claw-"):]
        if bot not in BOTS:
            continue
        ip = str(c.get("IPv4Address", "")).split("/")[0].strip()
        if ip:
            out[ip] = bot
    return out


def render(m):
    lines = ["# CLIENT_MAP — generated by claw-egress-sync from live container IPs.",
             "# DO NOT hand-edit; re-run the helper after a bot recreate.",
             f"# network={NETWORK}"]
    for ip in sorted(m):
        lines.append(f"{ip}={m[ip]}")
    return "\n".join(lines) + "\n"


def parse_map_file():
    """{ip: bot} as the PROXY currently sees it. Missing file ⇒ {}."""
    if not MAP_FILE.exists():
        return {}
    out = {}
    for line in MAP_FILE.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        ip, _, bot = line.partition("=")
        out[ip.strip()] = bot.strip()
    return out


def check_drift():
    """Report disagreement between live container IPs and the on-disk map.

    WHY THIS EXISTS: the sandboxed bots have no static ipv4_address, so Docker
    reassigns them on restart. On 2026-07-19 a Docker Desktop restart shuffled
    them and the map CROSS-MAPPED — 172.22.0.5 said "house" but was kolmogorov
    and .6 said "kolmogorov" but was house, so each bot was served the OTHER's
    learned egress namespace. That silently defeats the CLAW-050 isolation
    property, and NOTHING surfaced it: the proxy logs a populated bots map either
    way, and the only symptom was one unattributed denial in the vet queue.

    Exit status is the point — wire this into health checks so the next shuffle
    is loud. The real fix is static IPs; this makes the gap visible until then.

    Returns (mismatched, missing, stale):
      mismatched — ip maps to the WRONG bot   (isolation broken: A gets B's hosts)
      missing    — live bot absent from the map (that bot silently drops to base)
      stale      — mapped ip no longer any bot (points at a sidecar or nothing)
    """
    live, mapped = live_map(), parse_map_file()
    mismatched = {ip: (mapped[ip], live[ip]) for ip in live if ip in mapped and mapped[ip] != live[ip]}
    missing = {ip: bot for ip, bot in live.items() if ip not in mapped}
    stale = {ip: bot for ip, bot in mapped.items() if ip not in live}
    return mismatched, missing, stale


def main():
    if "--check" in sys.argv[1:]:
        mismatched, missing, stale = check_drift()
        for ip, (was, now) in sorted(mismatched.items()):
            print(f"[claw-egress-sync] MISMATCH {ip}: map says {was!r}, actually {now!r} "
                  f"→ {now} is being served {was}'s egress namespace")
        for ip, bot in sorted(missing.items()):
            print(f"[claw-egress-sync] UNMAPPED  {ip} ({bot}) → falls back to base-only egress")
        for ip, bot in sorted(stale.items()):
            print(f"[claw-egress-sync] STALE     {ip} mapped to {bot!r}, no such bot at that IP")
        if mismatched or missing or stale:
            print("[claw-egress-sync] per-bot egress partitioning is NOT intact — "
                  "run `claw-egress-sync` (no args) to resync.")
            return 1
        print(f"[claw-egress-sync] client.map matches all {len(live_map())} live bot(s) — partitioning intact")
        return 0

    m = live_map()
    text = render(m)
    if "--print" in sys.argv[1:]:
        sys.stdout.write(text)
        return 0
    LEARNED_DIR.mkdir(parents=True, exist_ok=True)
    MAP_FILE.write_text(text)
    print(f"[claw-egress-sync] wrote {len(m)} mapping(s) → {MAP_FILE}")
    for ip in sorted(m):
        print(f"    {ip} = {m[ip]}")
    print("    proxy hot-reloads within its poll interval.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
