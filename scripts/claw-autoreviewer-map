#!/usr/bin/env python3
"""claw-autoreviewer-map — write the autoreviewer bot's source-address -> bot map
from the LIVE container addresses (CLAW-119, .swarm/PEER_GRANTS.md §4).

The autoreviewer bot names the bot that proposes a grant from the caller's
source address, never from the request body. Container addresses can change
on recreate, so run this after ANY bot recreate. The autoreviewer bot re-reads
the map when its mtime changes; no restart is needed. A stale map fails safe:
an unmapped bot gets 403 and cannot propose.

Only the bots' GATEWAY containers are mapped. Exec sidecars (oasis-claw-<bot>-sandbox)
sit on their own networks, which the autoreviewer bot does not join.

Usage: claw-autoreviewer-map [--print]   (--print = show the map, do not write)

Env: OASIS_AUTOREVIEWER_DIR        (default ~/Library/Application Support/oasis-x/autoreviewer)
     OASIS_AUTOREVIEWER_CONTAINERS (default <dir>/containers.json: {"<container>": "<bot>"})
     OASIS_AUTOREVIEWER_NETWORKS   (default oasis-claw_oasis_sandboxed,oasis-claw_oasis_decider)
"""
import json
import os
import subprocess
import sys
from pathlib import Path

NETWORKS = [
    n.strip()
    for n in (os.environ.get("OASIS_AUTOREVIEWER_NETWORKS", "") or "oasis-claw_oasis_sandboxed,oasis-claw_oasis_decider").split(",")
    if n.strip()
]
OUT_DIR = Path(
    os.environ.get("OASIS_AUTOREVIEWER_DIR", "").strip()
    or Path.home() / "Library" / "Application Support" / "oasis-x" / "autoreviewer"
)
MAP_FILE = OUT_DIR / "client.map"
# Container name -> bot name (the reviewer's botKey and the mail relay's name).
# Deployment-specific, so it lives outside the repo, beside the map:
#   {"oasis-claw-mybot": "mybot", ...}
CONTAINERS_FILE = Path(os.environ.get("OASIS_AUTOREVIEWER_CONTAINERS", "").strip() or OUT_DIR / "containers.json")


def load_containers():
    try:
        return json.loads(CONTAINERS_FILE.read_text())
    except (OSError, ValueError) as e:
        print(f"[claw-autoreviewer-map] cannot read {CONTAINERS_FILE}: {e}", file=sys.stderr)
        sys.exit(1)


def live_map(containers):
    out = {}
    for net in NETWORKS:
        try:
            raw = subprocess.run(
                ["docker", "network", "inspect", net],
                capture_output=True, text=True, timeout=15, check=True,
            ).stdout
        except (subprocess.SubprocessError, FileNotFoundError) as e:
            print(f"[claw-autoreviewer-map] cannot inspect {net}: {e}", file=sys.stderr)
            continue
        for c in (json.loads(raw)[0].get("Containers") or {}).values():
            bot = containers.get(c.get("Name", ""))
            ip = str(c.get("IPv4Address", "")).split("/")[0].strip()
            if bot and ip:
                out[ip] = bot
    return out


def render(m):
    lines = [
        "# autoreviewer client map — generated by scripts/claw-autoreviewer-map.",
        "# DO NOT hand-edit; re-run after a bot recreate.",
    ]
    lines += [f"{ip}={m[ip]}" for ip in sorted(m)]
    return "\n".join(lines) + "\n"


def main():
    containers = load_containers()
    m = live_map(containers)
    missing = sorted(set(containers.values()) - set(m.values()))
    text = render(m)
    if "--print" in sys.argv:
        sys.stdout.write(text)
    else:
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        tmp = MAP_FILE.with_suffix(".tmp")
        tmp.write_text(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, MAP_FILE)
        print(f"[claw-autoreviewer-map] wrote {len(m)} entries to {MAP_FILE}")
    if missing:
        print(f"[claw-autoreviewer-map] not running or not on a mapped network: {', '.join(missing)}", file=sys.stderr)


if __name__ == "__main__":
    main()
