# oasis-claw runtime image — full openclaw gateway + our 9 extensions
#
# Uses npm-published openclaw@2026.4.26 (same version as vendor/openclaw submodule
# pin) and bakes our extensions in at /app/extensions/<id>. tsx loads the .ts
# entry points directly so we don't ship a compile step.
#
# Build:  docker build -f Dockerfile.runtime -t oasis-claw-runtime .
# Run:    docker compose -f docker-compose.runtime.yml up -d
#
# Networking note: gateway binds 0.0.0.0:18789 *inside* the container so
# Docker's port-publish can forward it. Host-side mapping is 127.0.0.1:18789
# (see compose) so LAN/IoT devices can't reach it. Auth token is mandatory.

FROM node:22-bookworm-slim

ARG OPENCLAW_VERSION=2026.4.26

# System batteries: git for plugin install, openssl for token gen, tini for
# proper signal handling, python3 for openclaw.json templating in entrypoint.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git openssl python3 procps lsof jq && \
    rm -rf /var/lib/apt/lists/*

# gog CLI for Gmail/Calendar/Drive (https://github.com/steipete/gogcli).
# OAuth tokens are encrypted with GOG_KEYRING_PASSWORD and live in the
# /home/node/.openclaw volume, so they persist across image rebuilds.
# Releases ship as gogcli_<version>_<os>_<arch>.tar.gz; binary inside is `gog`.
# TARGETARCH is set automatically by buildx (amd64 or arm64).
ARG GOGCLI_VERSION=0.15.0
ARG TARGETARCH
RUN case "${TARGETARCH:-amd64}" in \
      amd64) GOG_ARCH=linux_amd64 ;; \
      arm64) GOG_ARCH=linux_arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/steipete/gogcli/releases/download/v${GOGCLI_VERSION}/gogcli_${GOGCLI_VERSION}_${GOG_ARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin gog && \
    chmod +x /usr/local/bin/gog && \
    /usr/local/bin/gog --version

# openclaw CLI + tsx + sharp installed globally.
#
# sharp MUST be global, not at /app/node_modules: openclaw's runtime lives at
# /usr/local/lib/node_modules/openclaw/, so its `require("sharp")` walks
# parent dirs of that path and never reaches /app. Global install lands sharp
# at /usr/local/lib/node_modules/sharp, which is in NODE_PATH and reachable
# via the standard node_modules walk from openclaw's location.
#
# sharp ships prebuilt libvips binaries for linux-arm64 + linux-x64; no extra
# apt packages needed on bookworm-slim.
RUN npm install -g openclaw@${OPENCLAW_VERSION} tsx@4 sharp@0.34

WORKDIR /app

# Local /app/node_modules holds deps our extensions import (zod). Node's
# resolution from /app/extensions/<id>/index.ts walks up to /app/node_modules.
RUN npm init -y >/dev/null && \
    npm install --omit=dev zod@4

# Bake our 9 extensions into the image. Paths inside the container:
#   /app/extensions/<id>/{index.ts,openclaw.plugin.json,package.json,...}
COPY extensions/ /app/extensions/

# Strip any host-side node_modules that may have come along; we use /app/node_modules.
RUN find /app/extensions -type d -name node_modules -prune -exec rm -rf {} + || true

# Entry script: generates openclaw.json with plugin.entries pointing at the
# baked-in extensions, then execs `openclaw gateway`.
COPY scripts/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint.sh
RUN chmod +x /usr/local/bin/runtime-entrypoint.sh

# Run as the unprivileged "node" user that's already present in the base image.
RUN mkdir -p /home/node/.openclaw /home/node/.openclaw/workspace /home/node/.openclaw/logs && \
    chown -R node:node /home/node/.openclaw /app

USER node:node

ENV HOME=/home/node \
    NODE_PATH=/usr/local/lib/node_modules \
    OPENCLAW_GATEWAY_BIND=lan \
    OPENCLAW_GATEWAY_PORT=18789 \
    OPENCLAW_DISABLE_BONJOUR=1 \
    OPENCLAW_TZ=UTC

EXPOSE 18789

ENTRYPOINT ["/usr/local/bin/runtime-entrypoint.sh"]
